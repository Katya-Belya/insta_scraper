# Python
.venv/
__pycache__/
*.pyc
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Ingested and intermediate flyer data.
# Never commit scraped images: they are third-party content and may identify
# event organizers and attendees. Only data/sample/ is tracked.
# Ignore directory *contents* (not the directories) so .gitkeep can be re-included.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated output
results.csv
